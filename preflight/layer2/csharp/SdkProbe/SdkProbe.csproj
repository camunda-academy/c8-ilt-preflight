<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Layer 2 SDK-snippet confirmation (C#/.NET), tier 2.

    Package/version verified against the live NuGet registry and the tagged
    GitHub source, not assumed from an initial guess ("Camunda.Orchestration.Sdk 9.*, .NET 8+"):
      - The package name WAS correct: Camunda.Orchestration.Sdk really is the
        current Camunda 8 C#/.NET SDK
        (github.com/camunda/orchestration-cluster-api-csharp).
      - The initial "9.*" guess was a RANGE, which this project's exact-pin policy
        forbids for auto-install (a range lets a future compromised release in
        silently). The NuGet registry's listed versions top out at 9.1.3
        (published 2026-06-25). A 10.0.0 stable WAS published on NuGet but is
        UNLISTED (published date 1900-01-01, listed:false via the registration
        API) - superseded by the 10.0.0-alpha.x prerelease line, which targets
        Camunda 8.10. Per the SDK's own README: "SDK version n.y.z -> server
        version 8.n", so 9.y.z is the correct major for this project's 8.9
        target, matching the v9.1.3 git tag exactly. Pinned exactly to 9.1.3
        below (this project's hard security policy: exact-pinned auto-installed
        dependencies only, never a range).
      - TargetFramework is deliberately FIXED here, unlike Probe.csproj which
        derives it from the installed SDK. Two reasons pull this way:
        packages.lock.json records its resolved graph per target framework, and
        a restore in locked mode fails outright if the TFM being built has no
        matching entry - so a TFM that shifts with the machine's SDK would
        break the lockfile guarantee on any machine whose SDK major differs from
        whoever regenerated it. And unlike tier 1, this tier cannot be
        offline-only anyway: it exists to fetch and exercise the real SDK
        package, so the targeting-pack download that a fixed TFM may imply costs
        nothing it wasn't already paying.
        net8.0 is the value because it's the SDK's own declared minimum and the
        lowest major still buildable by every supported SDK (8, 9, 10) - a
        newer TFM could not be built at all by an older SDK, whereas this one
        builds everywhere and, being forward-compatible, runs everywhere.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SdkProbe</AssemblyName>
    <RootNamespace>CamundaPreflight.SdkProbe</RootNamespace>
    <NoWarn>$(NoWarn);CS8618</NoWarn>

    <!-- NuGet's hash-verification lockfile mechanism - the same supply-chain
         guarantee TypeScript gets from package-lock.json plus "npm ci".
         Generated once via a "dotnet restore" with lock-file generation
         enabled, and committed (packages.lock.json next to this file).
         run.sh/run.cmd's auto-install path restores in locked mode, which
         REFUSES to proceed if the resolved graph doesn't match the committed
         lock file - the same guarantee "npm ci" gives, npm's
         lockfile-and-integrity mechanism translated to the NuGet idiom. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Camunda.Orchestration.Sdk" Version="9.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared helpers - see Probe.csproj's identical Compile Include for why
         this is a linked source file rather than a project reference (mirrors
         Java's Shared.java being compiled into both Probe.java and
         SdkProbe.java independently, so a tier-2 dependency issue can never
         take down the mandatory tier-1 probe). -->
    <Compile Include="..\Shared\Shared.cs" Link="Shared.cs" />
  </ItemGroup>

</Project>
