<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Layer 2 native trust probe (C#/.NET), tier 1.
    Zero NuGet PackageReferences, deliberately: mirrors Java's Probe.java
    (javax.net.ssl only) and every other language's tier-1 probe - this is the
    mandatory, SDK-free trust check that must be able to run even if the real
    Camunda SDK can't be fetched (e.g. a broken corporate NuGet mirror).

    TargetFramework follows whichever .NET major the installed SDK provides,
    rather than naming a fixed one, because this tier must build on a machine
    whose access to nuget.org is exactly what's in question.

    A .NET SDK bundles the targeting pack ONLY for its own major version; asking
    it to build for an older major makes it fetch that pack from NuGet. So a
    hardcoded "net8.0" on a machine with just the .NET 9 SDK turns this
    dependency-free probe into one that silently needs the network - and on the
    blocked corporate networks this tool exists to diagnose, it would fail to
    build for a reason that has nothing to do with the customer's actual
    problem. Deriving the TFM from the SDK keeps tier 1 buildable offline on
    any .NET version.

    RollForward=LatestMajor covers the other half: the machine may carry a
    different set of runtimes than SDKs, and by default a framework-dependent
    app refuses to start on a newer major than it targeted.

    Override for a specific target with: dotnet build -p:TargetFramework=netX.0
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$([System.Version]::Parse($(NETCoreSdkVersion)).Major).0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Probe</AssemblyName>
    <RootNamespace>CamundaPreflight.Probe</RootNamespace>
    <!-- Keep build noise (restore/compile messages) off this probe's own
         stdout: run.sh/run.cmd additionally redirect the whole `dotnet
         build` step's stdout to stderr as belt-and-suspenders, since stdout
         here is a machine-parsed, newline-delimited JSON channel. -->
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared helpers, compiled into both Probe.csproj and SdkProbe.csproj:
         mirrors Java's Shared.java being compiled into both Probe.java and
         SdkProbe.java independently, so a tier-2 change can never break tier 1. -->
    <Compile Include="..\Shared\Shared.cs" Link="Shared.cs" />
  </ItemGroup>

</Project>
