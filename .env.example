# Camunda 8 ILT Preflight — environment variables
# Copy to .env and fill in values from Console → Clusters → <cluster> → API
#
# The preflight cluster is shared and ILT-owned. Get credentials from your training contact.

# Use the exact CAMUNDA_REST_ADDRESS from the credentials download. It may use
# either host family — bru-2.api.camunda.io OR bru-2.zeebe.camunda.io (interchangeable for REST).
CAMUNDA_REST_ADDRESS=https://bru-2.api.camunda.io/YOUR_CLUSTER_ID
CAMUNDA_CLIENT_ID=YOUR_CLIENT_ID
CAMUNDA_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Optional — defaults shown, change only if targeting a different region/tenant
# CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
# CAMUNDA_TOKEN_AUDIENCE=zeebe.camunda.io
